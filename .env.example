# Load order (later files override earlier ones):
#   1. ~/.config/ai-builders/.env
#   2. parent folders, e.g. the homework repo root
#   3. ./.env
# Optional path to provider catalog (default: ./providers.json)
# PROVIDERS_CONFIG=providers.json

# Default providers; override providers.json defaults
AGENT_PROVIDER=ai-builders
AGENT_SEARCH_PROVIDER=ai-builders
# Optional override for ai-builders default model
AGENT_MODEL=grok-4-fast

# AI Builders Space (LLM + search tools)
SUPER_MIND_API_KEY=your_api_key_here
BUILDER_API_KEY=your_api_key_here

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Local Ollama (key optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Any other OpenAI-compatible endpoint
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
